{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:university-physics-agent:schema:question:1.0",
  "title": "大学物理题目",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "language",
    "type",
    "knowledge_points",
    "difficulty",
    "statement",
    "provenance",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/stable_id" },
    "revision": { "type": "integer", "minimum": 1 },
    "language": { "const": "zh-CN" },
    "type": {
      "enum": ["conceptual", "numeric", "derivation", "multiple_choice"]
    },
    "knowledge_points": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stable_id" }
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "statement": { "type": "string", "minLength": 1 },
    "choices": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "answer": { "$ref": "#/$defs/answer" },
    "hints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hint" }
    },
    "explanation": { "type": "string", "minLength": 1 },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rubric_item" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "review": { "$ref": "#/$defs/review" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "conceptual" } } },
      "then": {
        "properties": {
          "answer": { "properties": { "kind": { "const": "text" } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "numeric" } } },
      "then": {
        "properties": {
          "answer": { "properties": { "kind": { "const": "numeric" } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "derivation" } } },
      "then": {
        "properties": {
          "answer": { "properties": { "kind": { "const": "derivation" } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "multiple_choice" } } },
      "then": {
        "required": ["choices"],
        "properties": {
          "answer": { "properties": { "kind": { "const": "choice" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "type": "object",
            "properties": { "status": { "const": "published" } },
            "required": ["status"]
          }
        },
        "required": ["review"]
      },
      "then": {
        "required": ["answer", "hints", "explanation", "rubric"],
        "properties": {
          "provenance": {
            "properties": { "human_reviewed": { "const": true } }
          }
        }
      }
    }
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "unit", "tolerance"],
          "properties": {
            "kind": { "const": "numeric" },
            "value": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 },
            "tolerance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "absolute": { "type": "number", "minimum": 0 },
                "relative": { "type": "number", "minimum": 0 }
              },
              "anyOf": [
                { "required": ["absolute"] },
                { "required": ["relative"] }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "assumptions",
            "equivalent_expressions",
            "key_steps"
          ],
          "properties": {
            "kind": { "const": "derivation" },
            "assumptions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "equivalent_expressions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "key_steps": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "choice_indexes"],
          "properties": {
            "kind": { "const": "choice" },
            "choice_indexes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            }
          }
        }
      ]
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "text"],
      "properties": {
        "level": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "rubric_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "points"],
      "properties": {
        "criterion": { "type": "string", "minLength": 1 },
        "points": { "type": "number", "exclusiveMinimum": 0 },
        "required": { "type": "boolean", "default": false }
      }
    },
    "course_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_title", "edition", "chapter", "verification_status"],
      "properties": {
        "book_title": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 },
        "chapter": { "type": ["string", "null"] },
        "verification_status": { "enum": ["pending", "verified"] }
      }
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": { "type": "string", "minLength": 1 },
        "paragraph": { "type": "string", "minLength": 1 },
        "stable_entry_id": { "type": "string", "minLength": 1 },
        "pdf_file_page": { "type": "integer", "minimum": 1 },
        "printed_page": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["section"] },
        { "required": ["paragraph"] },
        { "required": ["stable_entry_id"] },
        { "required": ["pdf_file_page"] },
        { "required": ["printed_page"] }
      ]
    },
    "factual_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator", "source_version", "license_id"],
      "properties": {
        "source_id": { "$ref": "#/$defs/stable_id" },
        "locator": { "$ref": "#/$defs/source_locator" },
        "source_version": { "type": "string", "minLength": 1 },
        "license_id": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "course_alignment",
        "factual_sources",
        "copied_text",
        "human_reviewed",
        "creation_method"
      ],
      "properties": {
        "kind": { "enum": ["original", "open_source", "course_mapping"] },
        "course_alignment": { "$ref": "#/$defs/course_alignment" },
        "factual_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/factual_source" }
        },
        "copied_text": { "type": "boolean" },
        "human_reviewed": { "type": "boolean", "default": false },
        "creation_method": { "enum": ["human", "agent"] },
        "transformation": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["original", "open_source"] } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "factual_sources": { "minItems": 1 } }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "in_review", "published", "rejected"] },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "published" } } },
          "then": { "required": ["reviewer_id", "reviewed_at", "evidence_refs"] }
        }
      ]
    }
  }
}
